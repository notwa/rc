if case $- in (*i*) [ ]; esac then
    # a non-interactive shell. technically this isn't supposed to happen,
    # as rc files are meant for interactive mode. however, due to legacy
    # reasons, certain scenarios will cause .bashrc to be sourced anyway.
    return # this prevents scp from blowing up or hanging
fi

# NOTE: history file settings have been moved to shrc.
unset HISTFILE HISTFILESIZE HISTSIZE # do not save history if shrc is missing
HISTCONTROL=erasedups

shopt -s autocd checkwinsize histappend
shopt -s -o hashall physical # enable hash and CHASE_LINKS
shopt -u -o histexpand # disable expansion of ! characters

dummy() { :; } ### @- return 0, ignoring arguments.
PS1='\[\e[0;1;$(($??31:32));7m\]\$\[\e[m\] ' # NOTE: this gets overwritten!
. ~/.shrc

reload() { ### @- reload the current shell -- runs initctl when passed arguments.
    if [ $# -gt 0 ]; then command reload "$@"; else exec bash -l; fi
}
! [ -e ~/.lol ] || . ~/.lol

true
