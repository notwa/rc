__grab() { ### @grab - download a file from my site and verify its integrity by its [minisign](https://github.com/jedisct1/minisign/) signature.
[ "$ZSH_VERSION" ] && emulate sh
#!/usr/bin/env sh
unset CDPATH e f fn fx hd IFS LC_ALL pub remote t task x || exit

pub=RWQdYTxDsppw5ZFpYZFoF6IoPS0okMKlOiz9MwTl0NUoP41r57sf9dI1
remote=eaguru.guru/t
export LC_ALL=C

will(){
task=$*
}

die(){
x=${?#0}
printf 'failed to %s\n' "$task" >&2
exit ${x:-1}
}

esc(){
while [ "$1" ]
do case $1 in
([\!\"$\&-\>@-~]*) printf %.1s "$1";;
(*) printf %%%02X "'$1"
esac
set -- "${1#?}"
done
} 2>&-

pick(){
command -v "$1" 2>/dev/null >&2 &&
exec "$@"
}

get()(
pick curl -sSfLgm5 -o "$@" ||
pick wget -qt1 -T5 -O "$@" ||
pick timeout 5 ftp -o "$@"
)

clean(){
will clean up temporary files
! [ -d "$t" ] || rm -r -- "$t" || die
}

hex(){
pick xxd -p -l4 -- "$@" ||
pick hexdump -ve '1/1 "%02x"' -n4 -- "$@"
}

will create temporary directory
for t in /dev/shm /var/shm /tmp
do [ -k "$t" ] && break
done
t=$(exec mktemp -dp "$t" grab.XXXXXXXXXX) || die

will change directory
cd -- "$t" && ! [ "$PWD" -ef "$OLDPWD" ] || die
trap clean INT EXIT

for f
do
fn=${f##*/}
fn=${fn%%\?*} # for shame, wget
fn=${fn%%#*}

will ensure filename is valid
case $fn in
(.|..|*[!\ -~]*|*[\":\<\>?\\\|]*) [ ];;
(?*);;
(*) [ ]
esac && >>"$fn" </dev/null || die

will ensure supported protocols
fx=$(esc "$fn")
case $f in
(http://*|https://*|ftp://*);;
(*:*)
printf 'unsupported protocol: %s\n' "${f%%:*}" >&2
die;;
(*)
f=https://$remote/$fx
esac

for e in '' .minisig
do
will "download $fn$e from $f$e"
get "$fn$e" -- "$f$e" || die
done

will "verify file integrity of $fn"
minisign -QVm "$fn" -P "$pub" || die

will clean up the signature file
rm -- "$fn.minisig" || die

will determine basic file type
hd=$(hex "$fn") || die

case $hd in
(7f454c46|2321*|4d5a*)
will set executable permission
chmod +x -- "$fn" || die
esac

done

will return files to original directory
find . -type f -exec mv -- {} "$OLDPWD/" \; || die

will remove temporary directory # assuming it's now emptied
cd -- "$OLDPWD" && rmdir -- "$t" || die

trap - INT EXIT
}

grab()(__grab "$@")
${preload+:} __grab "$@"
