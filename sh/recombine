#!/usr/bin/env false
# FAKE_COMPAT

[ -z "${IFS+-}" ] || { echo >&2 this script must be sourced from shrc; exit 1; }
cd -- "${HOME:?}/sh" || exit

query_inv() { ! return 1; }
query_big() { return 256; }
query_one() { x=1 query_two; }
query_two() { x=2 query_xxx; return $x; }
query_xxx() { x=3; }
query_order() { b=0; a=$b b=1 c=$b
                case $a$c in (00) x=0;; (01) x=1;; (10) x=2;; (*) x=3; esac; }

scrute() {
    case $0 in
    (/*) zero=${0##*/};;
    (-*) zero=${0#-};;
    (*) zero=$0
    esac
    case $zero in
    (scrute) like=zsh;;
    (loksh) like=oksh;;
    (???) like=_$zero;;
    (??) like=__$zero;;
    (*) like=$zero
    esac
    query_inv && like=$like:0 || like=$like:1
    query_big && like=$like:0 || like=$like:1
    query_one || like=$like:$? # never truthy
    query_order; like=$like:$x
}
scrute

# similar: (ash) (net-sh/zsh) (bash/mksh/osh) (dash/posh) (oksh) (ksh+m/yash)
case $like in
(__sh:0:0:1:1) SH=ASH  sh=ash;; # busybox sh
(__sh:0:1:1:0) SH=NET  sh=net;; # NetBSD sh
(__sh:1:0:1:1) SH=BASH sh=bash;;
(__sh:1:1:1:1) SH=DASH sh=dash;;
(__sh:1:1:2:1) SH=OKSH sh=oksh;; # OpenBSD ksh
(__sh:1:1:3:1) SH=KSH  sh=ksh;; # ksh93u+m
(__sh:1:1:3:2) SH=BSH  sh=bsh;; # Bourne shell (probably can't run this script)
(_ash:0:0:1:1) SH=ASH  sh=ash;;
(_jsh:1:1:3:2) SH=BSH  sh=bsh;; # Bourne shell with job control
(_ksh:1:0:1:1) SH=MKSH sh=mksh;; # MirBSD ksh
(_ksh:1:1:2:1) SH=OKSH sh=oksh;;
(_ksh:1:1:3:1) SH=KSH  sh=ksh;;
(_osh:1:0:1:1) SH=OSH  sh=osh;; # Oils
(_zsh:0:1:1:1) SH=ZSH  sh=zsh;;
(bash:1:0:1:1) SH=BASH sh=bash;;
(dash:1:1:1:1) SH=DASH sh=dash;;
(mksh:1:0:1:1) SH=MKSH sh=mksh;;
(oksh:1:1:2:1) SH=OKSH sh=oksh;;
(posh:1:1:1:1) SH=POSH sh=posh;;
(yash:1:1:3:1) SH=YASH sh=yash;;
(*) pl >&2 "unknown shell (\$0): $0"; exit 1
esac

pl '[ -n "$preload" ] || exit 1'
for f in *; do
    [ -n "${f##*.*}" ] && [ -f "$f" ] || continue
    ! [ -x "$f" ]; x=$? i=10 ok=
    while IFS= read -r line; do
        [ "$i" != 10 ] || case "${line%%[!!-~]*}" in (\#!*sh) ! :; esac || x=0
        check=0
        for word in $line; do
            case $word in (YES_$SH) ok=1;; (NO_$SH) ok=0;; (compat:) check=1;; esac
            [ "$check" != 1 ] || case "$word" in (+$sh) ok=1;; (-$sh) ok=0;; esac
        done
        [ "$((i-=1))" != 0 ] || break # act like head -n10
    done < "$f"

    if [ "$x" = 1 ] && [ "$ok" = 0 ]; then
        esc "$HOME/sh/$f"
        # ensure $f is a valid function name/identifier in all shells:
        case ${f:-:} in ([!A-Z_a-z]*) ! :;; (*[!0-9A-Z_a-z]*) ! :;; esac &&
        pl "$f() { '${a:-! :}' \"\$@\"; }"
    fi

    [ "$ok" != 1 ] || set -- "$@" "$f"
done
pl
[ $# = 0 ] || cat -- "$@"
pl 'entrypoint() { :; }' 'unset -f entrypoint'
