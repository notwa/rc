#!/usr/bin/env sh
# for busybox ash, dash, bash, and zsh.
set -Cefu && unset CDPATH IFS
program=$0
VERBOSE=${VERBOSE-1}

die() {
    printf '%s:' "$program"
    printf ' %s' "$@"
    printf '\n'
    exit 1
} >&2

list_files() {
    find "${1:-.}" -maxdepth 1 -printf '%P\n'
}

stash() {
    : "${1:?missing src}" # noted for its path
    : "${2:?missing dst}" # the file to backup
    printf '%s\n' "backing up $2"
    set -- "${backup_dir:?parameter null or not set}/${1#"$rc"}" "$2"
    mkdir -p -- "${1%/*}" || die "failed to create backup directory"
    ! [ -e "$1" ] || die "backup already exists: $1"
    mv -- "$2" "$1" || die "failed to backup $1"
}

hardlink() {
    : "${1:?missing src}"
    : "${2:?missing dst}"
    if [ -e "$2" ]; then
        ! [ "$1" -ef "$2" ] || return 0
        if [ -h "$2" ]; then
            printf '%s\n' "removing symbolic link $2"
            rm -- "$2" || die "failed to remove symbolic link"
        else
            stash "$1" "$2"
        fi
    fi

    ln -- "$1" "$2" || die "failed to create hardlink $2"
}

softlink_nix() {
    : "${1:?missing src}"
    : "${2:?missing dst}"
    if [ -e "$2" ]; then
        if [ -h "$2" ]; then
            [ "$(exec readlink -- "$2")" != "$1" ] || return 0
            printf '%s\n' "removing symbolic link $2"
            rm -- "$2" || die "failed to remove symbolic link"
        else
            die "$2 already exists and is not a symbolic link"
        fi
    fi

    ln -s -- "$1" "$2" || die "failed to create symlink $2"
}

softlink_pseudo() (
    : "${1:?missing src}"
    : "${2:?missing dst}"
    [ -d "$1" ] || die "$1 is not a directory to softlink"
    [ -d "$2" ] || mkdir -- "$2" || die "failed to make directory $2"

    list_files "$1" | while read -r f; do
        [ ${#f} != 0 ] || continue
        d1=$1/$f
        d2=$2/$f

        if [ -d "$d1" ]; then
            if [ "$d2" != .vim/bundle ]; then # buggy on Windows
                [ "$VERBOSE" -lt 2 ] || printf '\033[34m / \033[0m %s %s\n' "$d2" "$d1" >&2
                softlink_pseudo "$d1" "$d2" || exit
            fi
        elif [ -f "$d1" ]; then
            [ "$VERBOSE" -lt 2 ] || printf '\033[34m * \033[0m %s\n' "$d2" >&2
            hardlink "$d1" "$d2" || exit
        else
            die "i don't know how to pseudo-symlink $d1"
        fi
    done || exit
)

find_new_files() (
    : "${1:?missing src}"
    : "${2:?missing dst}"
    [ -d "$1" ] || die "$1 is not a directory to compare"
    [ -d "$2" ] || die "$2 is not a directory to explore"

    list_files "$2" | while read -r f; do
        [ ${#f} != 0 ] || continue
        d1=$1/$f
        d2=$2/$f

        case $d2 in
        (.vim/.netrwhist) continue;;
        (.vim/backup) continue;;
        (.vim/bundle) continue;;
        (.vim/swp) continue;;
        (.vim/undo) continue;;
        esac

        if [ -d "$d1" ]; then
            find_new_files "$d1" "$d2" || exit
        elif ! [ "$d1" -ef "$d2" ]; then
            [ -d "$d2" ] && ind=/ || ind=
            if [ "$VERBOSE" -lt 1 ]; then
                printf ' + %s%s\n' "$d2" "$ind" >&2
            else
                #printf 'new destination file. consider manually moving it:\n' >&2
                printf '\033[32m + \033[0m %s%s\n' "$d2" "$ind" >&2
            fi
        fi
    done
)

softlink() {
    if [ -n "${MSYSTEM:++}" ]; then
        # MSYS2 does not have nor emulate symbolic links.
        softlink_pseudo "$@" || exit
        # to make up for git status not seeing new files:
        find_new_files "$@" || exit
    else
        softlink_nix "$@"
    fi
}

readlink -f / >/dev/null || die 'failed sanity check (check your $PATH)'
rc=$(cd -- "${program%/*}/" && pwd -P) || die "failed to find rc directory"
cd -- "${HOME:?parameter null or not set}" || die "failed to change directory"
backup_dir=$rc/backup-$(exec date +%s) || die "failed to determine date"
! [ -d "$backup_dir" ] || die "backup directory already exists"

for f in \
    .bash_profile .zprofile .profile .bashrc .zshrc .shrc \
    .inputrc .ls_colors .tmux.conf .vimrc .Xresources \
; do
    hardlink "$rc/home/${f#.}" "$f"
done

for d in sh .vim; do
    softlink "$rc/${d#.}" "$d"
done

# create standard XDG directories:
mkdir -p .cache .config .local/bin .local/share .local/state &&
# create my preferred directories:
mkdir -p src work play || die "failed to create directories"
